# Fast path:
#   npm run setup
#
# Required. Use a long random value and keep it private.
REMOTE_TOKEN=change-me-to-a-long-random-token

# Optional. Defaults shown.
PORT=8787
HOST=127.0.0.1
CODEX_COMMAND=codex
CODEX_WORKDIR=/Users/you/Documents/your-project
CODEX_PROJECT_ROOTS=/Users/you/Documents

# To pair an Android phone on trusted Wi-Fi, temporarily set HOST=0.0.0.0.
# Set TRUST_PROXY=true only behind your trusted HTTPS tunnel/reverse proxy.
TRUST_PROXY=false

# Set this to your HTTPS tunnel or public URL to print a scannable remote QR.
# Example: https://codex.example.com
PUBLIC_URL=
