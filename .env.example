# Required for persistent remote access. Use a long random value.
REMOTE_TOKEN=change-me-to-a-long-random-token

# Optional. Defaults shown.
PORT=8787
HOST=0.0.0.0
CODEX_COMMAND=codex
CODEX_WORKDIR=/Users/himanshu

# Set this to your tunnel or public URL to print a scannable remote QR.
# Example: https://codex.example.com
PUBLIC_URL=
